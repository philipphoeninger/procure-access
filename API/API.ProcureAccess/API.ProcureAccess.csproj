<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Written to the build output only, where Swagger reads it (AppContext.BaseDirectory); publish includes it (#74). -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Swashbuckle brings Microsoft.OpenApi at the version it requires (3.11.0 for 11.0.1); there is no
      direct reference on purpose (owner, 2026-11-04, #74). CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc,
      parsing of circular schema references) is fixed in 2.7.5 and 3.5.4; the API only writes
      documents. Swashbuckle 11 still writes OpenAPI 3.0 documents (S5-04).
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../DAL/DAL.ProcureAccess/DAL.ProcureAccess.csproj" />
    <ProjectReference Include="../../DAL/MODELS.ProcureAccess/MODELS.ProcureAccess.csproj" />
    <ProjectReference Include="../../SERVICES/SERVICES.ProcureAccess/SERVICES.ProcureAccess.csproj" />
  </ItemGroup>

  <!-- Module projects (ARCHITECTURE §4.3). The host references only the modules; their contracts come with them. -->
  <ItemGroup>
    <ProjectReference Include="../../src/ProcureAccess.Modules.Platform/ProcureAccess.Modules.Platform.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.IdentityAccess/ProcureAccess.Modules.IdentityAccess.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Catalog/ProcureAccess.Modules.Catalog.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Configurator/ProcureAccess.Modules.Configurator.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Export/ProcureAccess.Modules.Export.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Directory/ProcureAccess.Modules.Directory.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Workspace/ProcureAccess.Modules.Workspace.csproj" />
    <ProjectReference Include="../../src/ProcureAccess.Modules.Moderation/ProcureAccess.Modules.Moderation.csproj" />
  </ItemGroup>

</Project>
