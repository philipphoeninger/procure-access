{
  "name": "procureaccess-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Playwright end-to-end and accessibility tests for ProcureAccess (TESTING §3.3, §5.4)",
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "stack:up": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml up --build -d --wait",
    "stack:down": "docker compose -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "test": "playwright test",
    "typecheck": "tsc -p .",
    "lint": "cd .. && eslint -c e2e/eslint.config.mjs e2e scripts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
