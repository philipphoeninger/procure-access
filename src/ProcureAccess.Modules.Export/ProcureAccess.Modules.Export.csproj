<!-- Export module (ARCHITECTURE §4.3). Only controllers and AddExportModule are public; ARC-03. -->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Exactly the references ARCHITECTURE §4.3 allows: the module's own contracts, the listed contracts of other modules and Platform's contracts. Never a legacy project (API, DAL, MODELS, SERVICES). -->
  <ItemGroup>
    <ProjectReference Include="../ProcureAccess.Modules.Export.Contracts/ProcureAccess.Modules.Export.Contracts.csproj" />
    <ProjectReference Include="../ProcureAccess.Modules.Catalog.Contracts/ProcureAccess.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="../ProcureAccess.Modules.Configurator.Contracts/ProcureAccess.Modules.Configurator.Contracts.csproj" />
    <ProjectReference Include="../ProcureAccess.Modules.Platform.Contracts/ProcureAccess.Modules.Platform.Contracts.csproj" />
  </ItemGroup>

  <!-- The texts of the export files (S4-20a), copied from the UX copy by scripts/check-i18n.mjs in its write mode. -->
  <ItemGroup>
    <EmbeddedResource Include="Texts/de.json" LogicalName="ProcureAccess.Modules.Export.Texts.de.json" />
  </ItemGroup>

  <!-- The test projects reach the internal pipeline (S4-19), as for the Catalog module. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAccess.Tests.Unit" />
    <InternalsVisibleTo Include="ProcureAccess.Tests.Integration" />
    <InternalsVisibleTo Include="ProcureAccess.Tests.Architecture" />
  </ItemGroup>

</Project>
