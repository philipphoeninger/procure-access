<!-- Architecture tests: NetArchTest and reflection-based structural invariants (TESTING §3.4, ARCHITECTURE §4.3). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform (see global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Exit code 8 = "no tests ran". Allowed while this project is still empty (S1-12).
      ARC-06 is a unit test (TESTING §4.10, S1-14), so the first tests here are the module
      rules ARC-01–03 of migration step 1; remove this line together with them.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- The production assemblies whose structure is inspected. -->
  <ItemGroup>
    <ProjectReference Include="../../API/API.ProcureAccess/API.ProcureAccess.csproj" />
    <ProjectReference Include="../../DAL/DAL.ProcureAccess/DAL.ProcureAccess.csproj" />
    <ProjectReference Include="../../DAL/MODELS.ProcureAccess/MODELS.ProcureAccess.csproj" />
    <ProjectReference Include="../../SERVICES/SERVICES.ProcureAccess/SERVICES.ProcureAccess.csproj" />
  </ItemGroup>

</Project>
