<!-- Integration and contract tests: WebApplicationFactory + Testcontainers PostgreSQL 17 (TESTING §3.4, §5.2). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform (see global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAccess.Tests.Shared/ProcureAccess.Tests.Shared.csproj" />
    <ProjectReference Include="../../API/API.ProcureAccess/API.ProcureAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded expectations of characterisation tests (CAT-10), read at run time. -->
    <None Update="Catalog/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The real release folders (catalog/releases/<version>/), every file as the API image ships them, imported by Release2026_1Tests (S3-27). -->
    <None Include="../../catalog/releases/**/*" Link="CatalogReleases/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The metric queries of R-MET-02 are run from the document itself by MetricQueryTests (S6-30). -->
    <None Include="../../docs/TECHNICAL.md" Link="Docs/TECHNICAL.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
