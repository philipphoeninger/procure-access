<!-- Shared test code: builders, fixtures, sentinel values, test auth handler (TESTING §3.4, §6). Not a test project. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core authentication types for the test authentication handler. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../DAL/MODELS.ProcureAccess/MODELS.ProcureAccess.csproj" />
    <!-- Catalog builders and the MiniCatalog (S3-14) use the module's internal types. -->
    <ProjectReference Include="../../src/ProcureAccess.Modules.Catalog/ProcureAccess.Modules.Catalog.csproj" />
  </ItemGroup>

  <!-- The catalog builders are internal, because the types they build are. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAccess.Tests.Unit" />
    <InternalsVisibleTo Include="ProcureAccess.Tests.Integration" />
  </ItemGroup>

</Project>
