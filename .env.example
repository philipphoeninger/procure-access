# Template for .env (read by docker-compose). Copy to .env and fill in every empty secret:
# docker-compose stops with an error while DB_PASSWORD or JWT_KEY is empty.
# .env is git-ignored. Never commit real values: the repository is public.

# environment settings
#   Development  local stack: sample data is reseeded on startup (RebuildDatabase)
#   Production   deployment: RebuildDatabase never runs outside Development (SEC-06)
ASPNETCORE_ENVIRONMENT=Development

# database
DB_HOST=db
DB_NAME=ProcureAccessDb
DB_USER=postgres
# DB_PASSWORD: letters and digits only, e.g. openssl rand -hex 24. It is substituted into the
# API connection string, where ; " and $ break it.
# Changing it here does not change the password of an existing database: PostgreSQL reads it
# only when the postgres_data volume is created. To rotate, first run on the running stack
#   docker compose exec db psql -U <DB_USER> -d <DB_NAME> -c "\password <DB_USER>"
# (prompts for the new password), then put the new value here and run docker compose up -d.
DB_PASSWORD=
DB_PORT_OUTER=5432
DB_PORT_INNER=5432

# api & client ports
API_PORT_OUTER=5000
API_PORT_INNER=8080
CLIENT_PORT_OUTER=4200
CLIENT_PORT_INNER=80

# client image build: Angular build configuration(s)
#   production,local  optimised build that calls the local API (http://localhost:5000/api)
#   production        optimised build that calls https://api.procureaccess.tech/api (Dokploy)
CLIENT_BUILD_CONFIGURATION=production,local

# JWT signing key, at least 32 bytes, e.g.: openssl rand -base64 64
JWT_KEY=

# e-mail (SMTP relay; leave empty locally if no mail is needed)
SMTP_USERNAME=
SMTP_PASSWORD=

# sample user (Development only): sample.user@example.org, created on every start with this
# password; empty = no sample user. Needs upper and lower case, a digit and a special character.
SAMPLE_USER_PASSWORD=
