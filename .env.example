# Template for .env (read by docker-compose). Copy to .env and fill in every empty secret:
# docker-compose stops with an error while DB_PASSWORD is empty.
# .env is git-ignored. Never commit real values: the repository is public.

# environment settings
#   Development  local stack: sample data is reseeded on startup (RebuildDatabase)
#   Production   deployment: RebuildDatabase never runs outside Development (SEC-06)
#   docker-compose.yml uses Production when this line is missing
ASPNETCORE_ENVIRONMENT=Development

# database
DB_HOST=db
DB_NAME=ProcureAccessDb
DB_USER=postgres
# DB_PASSWORD: letters and digits only, e.g. openssl rand -hex 24. It is substituted into the
# API connection string, where ; " and $ break it.
# Changing it here does not change the password of an existing database: PostgreSQL reads it
# only when the postgres_data volume is created. To rotate, first run on the running stack
#   docker compose exec db psql -U <DB_USER> -d <DB_NAME> -c "\password <DB_USER>"
# (prompts for the new password), then put the new value here and run docker compose up -d.
DB_PASSWORD=
DB_PORT_OUTER=5432
DB_PORT_INNER=5432

# Data Protection key ring encryption (S4-26). Required outside Development and E2E: the API
# stops at startup without it. Leave both empty for the local stack (keys stored unencrypted).
# Value: a PFX with an RSA private key and WITHOUT password, base64-encoded on one line, e.g.
#   openssl req -x509 -newkey rsa:3072 -sha256 -days 3650 -nodes -subj "/CN=ProcureAccess key ring" \
#     -keyout keyring-key.pem -out keyring-cert.pem
#   openssl pkcs12 -export -inkey keyring-key.pem -in keyring-cert.pem -passout pass: -out keyring.pfx
#   base64 -w0 keyring.pfx
# Keep the PFX outside the repository and apart from the database backups; without it the keys in
# the database cannot be read. Rotation: move the old value to DATA_PROTECTION_PREVIOUS_CERTIFICATE
# and set a new one; the previous certificate only reads keys created before the rotation.
DATA_PROTECTION_CERTIFICATE=
DATA_PROTECTION_PREVIOUS_CERTIFICATE=

# e-mail (SMTP relay, Lettermint; S5-11): the API token as username and password, as Lettermint
# documents it. Required outside Development and E2E — the API does not start without them. The dev
# and E2E stacks send to Mailpit instead (docker-compose.dev.yml, http://localhost:8025) and need
# none; with docker-compose.yml alone in Development, mail is attempted at Lettermint and fails
# without them. The sample user below needs no e-mail.
SMTP_USERNAME=
SMTP_PASSWORD=

# sample user (Development only): sample.user@example.org, created on every start with this
# password; empty = no sample user. Needs upper and lower case, a digit and a special character.
SAMPLE_USER_PASSWORD=
